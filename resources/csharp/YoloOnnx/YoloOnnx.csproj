<Project Sdk="Microsoft.NET.Sdk">

  <!-- Week 9B C# corner: run the conveyor detector exported to ONNX from C#.
       Build: dotnet build    Run: dotnet run -- path/to/best.onnx path/to/scene.jpg 0.25 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20240616" />
    <!-- Native OpenCV binaries: Windows is covered by this package. On Linux/macOS see README.md. -->
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20240616" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>

</Project>
